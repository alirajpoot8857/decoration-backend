# Port for Backend Server
PORT=5000

# Database URL (SQLite default for zero-config local run, or PostgreSQL: postgresql://user:password@localhost:5432/lumiere_decor)
DATABASE_URL="file:./dev.db"

# JWT Secret & Expiry
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# CORS Origin for Next.js Frontend
CORS_ORIGIN="http://localhost:3000"

# Node Environment
NODE_ENV="development"
